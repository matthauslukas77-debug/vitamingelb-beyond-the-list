# Kopiere diese Datei nach .env.local und trage die Werte ein.
#   cp .env.example .env.local
#
# .env.local ist in .gitignore — Schlüssel gehören NIE ins öffentliche Jury-Repo.
# In Vercel werden dieselben Namen unter Settings → Environment Variables gesetzt.
#
# Wichtig: Nur Variablen mit dem Präfix VITE_ landen im Browser-Bundle.
# Alles mit VITE_ ist damit öffentlich sichtbar — hier gehört ausschliesslich
# der anon/publishable Key hinein, niemals der service_role Key.

# Supabase — Projekt-URL, z. B. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase — anon / publishable key (öffentlich, durch Row Level Security geschützt)
VITE_SUPABASE_ANON_KEY=
